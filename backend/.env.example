# ─── Runtime ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=4000
# LOG_LEVEL=info
# SHUTDOWN_TIMEOUT_MS=10000

# ─── Database (MongoDB) ────────────────────────────────────────────────────
# Required. Production must use mongodb:// or mongodb+srv:// (not localhost
# unless ALLOW_LOCAL_MONGO_IN_PROD=1 for deliberate local prod-mode tests).
MONGODB_URI=mongodb://127.0.0.1:27017/luxora
#
# Pool / timeouts (conservative production defaults; safe for development)
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=0
# MONGODB_MAX_IDLE_MS=60000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_HEARTBEAT_FREQUENCY_MS=10000
# MONGODB_PING_TIMEOUT_MS=2000
#
# Index creation on connect (createIndexes only — never syncIndexes).
# Default: true in development/test, MUST be false in production.
# Create/update indexes via ops/migration: ensureIndexes() or mongosh.
# MONGODB_AUTO_INDEX=false

# ─── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
# Prefer shorter lifetimes until refresh tokens exist (15m–1h).
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=luxora_token
AUTH_COOKIE_SAMESITE=lax

# ─── CORS / store presentation ─────────────────────────────────────────────
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORE_DISPLAY_NAME=Luxora

# ─── Security / limits ─────────────────────────────────────────────────────
JSON_BODY_LIMIT=100kb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# ─── Payments ──────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
PAYMENT_RESERVATION_TTL_MS=1800000
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

# Schedulers (Mongo lease-safe). Prefer one replica OR external cron → admin APIs.
ENABLE_RESERVATION_SCHEDULER=false
RESERVATION_SCHEDULER_INTERVAL_MS=300000
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_SCHEDULER_INTERVAL_MS=60000
ENABLE_RECONCILE_SCHEDULER=false
RECONCILE_SCHEDULER_INTERVAL_MS=300000

# ─── Notifications ─────────────────────────────────────────────────────────
SMS_PROVIDER=mock
# SMS_API_KEY=           # required when SMS_PROVIDER=kavenegar
# KAVENEGAR_SENDER=
# KAVENEGAR_BASE_URL=https://api.kavenegar.com/v1

EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@luxora.local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=60000
NOTIFICATION_LEASE_MS=60000
