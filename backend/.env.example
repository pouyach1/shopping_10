# ─── Runtime ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=4000

# ─── Database ──────────────────────────────────────────────────────────────
# Required in every environment. In production the process exits if missing
# or unreachable at startup.
MONGODB_URI=mongodb://127.0.0.1:27017/luxora

# ─── Authentication ────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random secret (32+ characters).
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Access-token lifetime accepted by jsonwebtoken (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# Cookie name for the httpOnly access token (browser clients)
AUTH_COOKIE_NAME=luxora_token

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Never use * in production.
# Example: http://localhost:5173,https://shop.example.com
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Security / limits ─────────────────────────────────────────────────────
# Max JSON body size for express.json()
JSON_BODY_LIMIT=100kb

# Auth endpoint rate limit (per IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# General API rate limit (per IP)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# ─── Payments (Phase 5–6) ──────────────────────────────────────────────────
# mock | zarinpal | idpay | stripe
# Development/test default: mock. Production must NOT use mock.
PAYMENT_PROVIDER=mock

# Browser return URL after gateway redirect (frontend /payment/callback)
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback

# Shared secret for webhook HMAC (required in production, 16+)
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me

# Reservation TTL for unpaid online orders (ms). Default 30 minutes.
PAYMENT_RESERVATION_TTL_MS=1800000

# Zarinpal v4 (required when PAYMENT_PROVIDER=zarinpal — 36-char merchant UUID)
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

# In-process schedulers (enable on exactly one production instance, or use cron → admin endpoints)
ENABLE_RESERVATION_SCHEDULER=false
RESERVATION_SCHEDULER_INTERVAL_MS=300000
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_SCHEDULER_INTERVAL_MS=60000

# ─── Notifications ─────────────────────────────────────────────────────────
SMS_PROVIDER=mock
# SMS_API_KEY=  # required when SMS_PROVIDER=kavenegar
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@luxora.local
