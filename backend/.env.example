# ─── Runtime ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=4000

# Bounded graceful shutdown (HTTP drain + Mongo disconnect), milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# ─── Database (required for commerce) ─────────────────────────────────────
# Development/test default to local Mongo when unset.
# PRODUCTION: MONGODB_URI is required (no default). Process exits if invalid.
#
# Atlas example (do not commit real credentials):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/luxora?retryWrites=true&w=majority
#
# Self-hosted replica set example:
# MONGODB_URI=mongodb://USER:PASS@mongo-1:27017,mongo-2:27017,mongo-3:27017/luxora?replicaSet=rs0&authSource=admin
#
# Never log the raw URI. The app redacts credentials in diagnostics.
MONGODB_URI=mongodb://127.0.0.1:27017/luxora

# Production only: allow URI targeting localhost / 127.0.0.1 (default false).
# Set true only for intentionally self-hosted single-node production deploys.
MONGODB_ALLOW_LOCALHOST=false

# Connection pool (conservative defaults applied when unset)
# Production defaults: max 20, min 2. Development: max 10, min 0.
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=2
# MONGODB_MAX_IDLE_TIME_MS=60000

# Timeouts / monitoring (milliseconds)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_HEARTBEAT_FREQUENCY_MS=10000
# MONGODB_PING_TIMEOUT_MS=2000

# Driver appName reported to MongoDB (ops visibility)
# MONGODB_APP_NAME=luxora-backend

# Index policy
# Unset → autoIndex ON in development/test, OFF in production.
# Production must pre-create indexes via controlled ops — never syncIndexes on boot.
# MONGODB_AUTO_INDEX=false
#
# Unset → bufferCommands OFF in production (fail fast when disconnected),
# ON in development/test.
# MONGODB_BUFFER_COMMANDS=false

# ─── Authentication ────────────────────────────────────────────────────────
# REQUIRED in production. Use a long random secret (32+ characters).
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Access-token lifetime accepted by jsonwebtoken (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# Cookie name for the httpOnly access token (browser clients)
AUTH_COOKIE_NAME=luxora_token

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Never use * in production.
# Example: http://localhost:5173,https://shop.example.com
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Security / limits ─────────────────────────────────────────────────────
# Max JSON body size for express.json()
JSON_BODY_LIMIT=100kb

# Auth endpoint rate limit (per IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# General API rate limit (per IP)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
